# Tencent Cloud COS (keep these values on the server only)
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET=example-1250000000

# Application
DATABASE_URL=sqlite:///./data/video_show.db
CORS_ORIGINS=https://wikiroco.com,http://localhost:5173,http://localhost:8002
APP_PORT=8002
MAX_UPLOAD_SIZE_GB=20
UPLOAD_PART_SIZE_MB=16
UPLOAD_URL_EXPIRES_SECONDS=3600
MEDIA_URL_EXPIRES_SECONDS=21600
UPLOAD_SESSION_HOURS=24

# Docker build download mirrors (defaults target networks in mainland China)
DOCKER_NPM_REGISTRY=https://registry.npmmirror.com
DOCKER_DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
DOCKER_DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
DOCKER_PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
